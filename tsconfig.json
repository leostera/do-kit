{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": { "@leostera/do-kit": ["./src/index.ts"], "@leostera/do-kit/*": ["./src/*/index.ts"] },
    "types": ["@cloudflare/workers-types", "node", "bun"]
  },
  "include": ["src", "test", "specs", "bench", "examples"]
}
