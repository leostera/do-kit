{
  "name": "@leostera/do-kit",
  "version": "0.2.0",
  "description": "Building blocks for Cloudflare Durable Objects: sharded objects that split themselves as they grow",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sharded": {
      "types": "./dist/sharded/index.d.ts",
      "import": "./dist/sharded/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "specs:check": "feynman check",
    "bench:run": "bun bench/run.ts",
    "bench:plot": "bun bench/plot.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "5.20261027.1",
    "@leostera/feynman": "0.10.0",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "cf": "^1.0.0-beta.23",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leostera/do-kit.git"
  },
  "homepage": "https://github.com/leostera/do-kit#readme",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "workers",
    "sharding"
  ],
  "publishConfig": {
    "access": "public"
  }
}
