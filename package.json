{
  "name": "@leostera/do-kit",
  "version": "0.4.0",
  "description": "Building blocks for Cloudflare Durable Objects: sharded objects that split themselves as they grow",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sharded": {
      "types": "./dist/sharded/index.d.ts",
      "import": "./dist/sharded/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "specs:check": "feynman check",
    "bench:run": "bun bench/run.ts",
    "bench:plot": "bun bench/plot.ts"
  },
  "devDependencies": {
    "@cloudflare/kumo": "^2.16.0",
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "5.20261027.1",
    "@leostera/feynman": "0.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.23",
    "echarts": "^6.1.0",
    "fast-check": "^4.10.2",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leostera/do-kit.git"
  },
  "homepage": "https://github.com/leostera/do-kit#readme",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "workers",
    "sharding"
  ],
  "publishConfig": {
    "access": "public"
  }
}
